{
  "name": "grok-live-translate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time speech translation and multi-agent voice demos on the SpaceXAI Grok Voice speech-to-speech API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "server": "tsx src/server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:agents": "tsx scripts/agents-e2e.ts",
    "e2e:live": "tsx scripts/live-e2e.ts",
    "e2e:builder": "tsx scripts/builder-e2e.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "license": "UNLICENSED"
}
