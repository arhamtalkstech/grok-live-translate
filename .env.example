# SpaceXAI API key (https://console.x.ai). Server-side only; never commit a real key.
XAI_API_KEY=

# Voice model. grok-voice-latest points at the newest Grok Voice model (the resolved name is shown in the UI).
VOICE_MODEL=grok-voice-latest
# none (default) or high.
VOICE_REASONING_EFFORT=none

# Demo server (holds the API key). Stays on localhost unless you change it.
LT_HOST=127.0.0.1
LT_PORT=8787
# Vite dev UI.
LT_WEB_HOST=127.0.0.1
LT_WEB_PORT=5174
# 1 = serve the dev UI over self-signed HTTPS (needed for a second device's mic on the LAN).
LT_HTTPS=

# Longest single turn before it is committed anyway (ms).
MAX_TURN_MS=15000
# Agent builder: base URL of the bank API its tools call. Defaults to the mock bank built into the server.
MOCK_BANK_URL=
# 1 = log every Grok Voice event and mic level on the server.
LT_DEBUG=
